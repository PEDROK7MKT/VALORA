/* =====================================================================
   VALORA SUISSE · páginas da loja (produto, coleção, página, busca,
   carrinho, 404, políticas no rodapé)
   Mesmo vocabulário do valora-site.css: variáveis, .sec, .psec-h, .grid5,
   .prod, .eye, .btn. O valora-site.css continua igual ao do site.
   ===================================================================== */

/* ---------------------------------------------------------------- títulos de página */
.pd-title,
.psec-h h1,
.pg h1,
.nf h1 {
  font-family: var(--serif);
  font-weight: 500;
  line-height: 1.08;
  letter-spacing: -.005em;
  color: var(--verde);
  text-wrap: balance;
}
.psec-h h1 { font-size: clamp(2rem, 3.6vw, 3.1rem); }

/* voltar */
.crumbs { margin-bottom: clamp(14px, 2.4vw, 26px); font-size: .78rem; letter-spacing: .04em; }
.back {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  min-height: 44px;
  color: var(--suave);
  text-decoration: underline;
  text-decoration-color: transparent;
  text-underline-offset: 3px;
  transition: color .3s, text-decoration-color .3s;
}
.back:hover { color: var(--verde); text-decoration-color: currentColor; }

/* ---------------------------------------------------------------- produto */
.pd-sec { padding-top: clamp(16px, 3vw, 40px); }
.pd-grid {
  display: grid;
  grid-template-columns: minmax(0, 1.15fr) minmax(0, .85fr);
  gap: clamp(32px, 5vw, 80px);
  align-items: start;
}
.pd-media { display: grid; gap: 14px; }
.pd-img {
  position: relative;
  display: grid;
  place-items: center;
  aspect-ratio: 4 / 5;
  overflow: hidden;
  background: var(--poco);
}
.pd-img img,
.pd-img video,
.pd-img iframe { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; border: 0; }
.pd-info { position: sticky; top: calc(var(--hd-h) + 28px); }
.pd-title { font-size: clamp(2.2rem, 4vw, 3.4rem); }
.pd-buy { margin-top: 20px; padding-top: 20px; border-top: 1px solid var(--linha); }
.pd-sku { margin: 0 0 8px; }
.pd-price { display: flex; align-items: baseline; gap: 12px; }
.pd-price .price { font-size: 1.35rem; }
.pd-was { font-size: .95rem; color: var(--suave); }
.pd-label {
  display: block;
  margin-top: 22px;
  font-size: .72rem;
  font-weight: 600;
  letter-spacing: .14em;
  text-transform: uppercase;
  color: var(--verde);
}
.pd-select { position: relative; margin-top: 8px; }
.pd-select select {
  -webkit-appearance: none;
  appearance: none;
  width: 100%;
  min-height: 50px;
  padding: 0 44px 0 16px;
  border: 1px solid var(--trait);
  border-radius: var(--r-ui);
  background: var(--branco);
  font: inherit;
  font-size: max(16px, .95rem);
  color: var(--texto);
}
.pd-select::after {
  content: '';
  position: absolute;
  top: 50%;
  right: 18px;
  width: 8px;
  height: 8px;
  border-right: 1.5px solid var(--verde);
  border-bottom: 1.5px solid var(--verde);
  transform: translateY(-70%) rotate(45deg);
  pointer-events: none;
}
.add.pd-add {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  min-height: 54px;
  margin-top: 22px;
  border-color: var(--verde);
  background: var(--verde);
  color: var(--marfim);
  font-size: .875rem;
  letter-spacing: .02em;
}
.add.pd-add:hover { border-color: var(--musgo); background: var(--musgo); }
.add.pd-add.is-added { border-color: var(--ouro); background: var(--ouro); color: var(--verde); }
.add.pd-add[disabled] { opacity: .5; cursor: not-allowed; }
.pd-wa { width: 100%; margin-top: 10px; }
.pd-desc { margin-top: 28px; font-size: 1rem; line-height: 1.85; }
.pd-trust {
  display: grid;
  gap: 12px;
  margin-top: 28px;
  padding-top: 22px;
  border-top: 1px solid var(--linha);
  list-style: none;
  font-size: .72rem;
  font-weight: 500;
  letter-spacing: .14em;
  text-transform: uppercase;
  color: var(--verde);
}
.pd-trust li { display: flex; align-items: center; gap: 10px; }
.pd-trust svg { flex: none; width: 9px; height: 9px; color: var(--ouro); }
.pd-more { background: var(--papel); }
.pd-more .sec { padding-top: clamp(48px, 6vw, 80px); padding-bottom: clamp(48px, 6vw, 80px); }
.psec-all { font-size: .8rem; color: var(--verde); white-space: nowrap; text-decoration: underline; text-underline-offset: 3px; }

/* ---------------------------------------------------------------- peças sem preço: pedido pelo WhatsApp */
/* o card segura o texto só para leitor de tela do botão (.sr-only é absoluto): sem isso ele escapa
   da grade com rolagem lateral e alarga a página no celular */
.prod { position: relative; }
.p-ask { font-family: var(--serif); font-style: italic; font-size: 1.1rem; line-height: 1.2; color: var(--ouro-txt); }
.p-foot--ask { flex-wrap: wrap; gap: 8px 10px; }
.add.order { display: inline-flex; align-items: center; justify-content: center; }
.pd-price .p-ask { font-size: 1.5rem; }
.pd-order { width: 100%; min-height: 54px; margin-top: 22px; }
.pd-note { margin-top: 12px; font-size: .8rem; line-height: 1.6; color: var(--suave); }

/* ---------------------------------------------------------------- texto vindo do admin (descrição, páginas) */
.rte > * + * { margin-top: 1em; }
.rte h2,
.rte h3,
.rte h4 { font-family: var(--serif); font-weight: 500; line-height: 1.15; color: var(--verde); }
.rte h2 { margin-top: 1.4em; font-size: 1.9rem; }
.rte h3 { margin-top: 1.3em; font-size: 1.45rem; }
.rte h4 { margin-top: 1.2em; font-size: 1.2rem; }
.rte a { color: var(--verde); text-decoration: underline; text-underline-offset: 3px; }
.rte strong { font-weight: 600; }
.rte ul,
.rte ol { padding-left: 1.3em; }
.rte li + li { margin-top: .4em; }
.rte img { height: auto; }
.rte table { width: 100%; border-collapse: collapse; font-size: .9rem; }
.rte th,
.rte td { padding: 8px 10px; border: 1px solid var(--linha); text-align: left; vertical-align: top; }
.rte blockquote {
  padding-left: 18px;
  border-left: 2px solid var(--ouro);
  font-family: var(--serif);
  font-style: italic;
  font-size: 1.25rem;
  color: var(--verde);
}

/* ---------------------------------------------------------------- coleção, busca, carrinho */
.pcoll .sec,
.srch .sec,
.cartp .sec { padding-top: clamp(16px, 3vw, 40px); padding-bottom: clamp(64px, 8vw, 104px); }
.pcoll-desc { margin: -6px 0 28px; }
.grid5.grid5--page { row-gap: clamp(32px, 4vw, 48px); }
.pager {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  justify-content: center;
  gap: 14px 18px;
  margin-top: clamp(40px, 5vw, 64px);
}
.pager-n { font-size: .8rem; color: var(--suave); }

/* página de conteúdo */
.pg-sec { max-width: 820px; padding-top: clamp(32px, 5vw, 64px); }
.pg h1 { margin-bottom: clamp(20px, 3vw, 32px); font-size: clamp(2.2rem, 4vw, 3.2rem); }
.pg .rte { font-size: 1rem; line-height: 1.85; }

/* 404 */
.nf h1 { font-size: clamp(2.2rem, 4vw, 3.2rem); }

/* busca */
.s-form { display: flex; gap: 10px; margin-bottom: clamp(28px, 4vw, 44px); }
.s-input {
  flex: 1;
  min-width: 0;
  min-height: 50px;
  padding: 0 16px;
  border: 1px solid var(--trait);
  border-radius: var(--r-ui);
  background: var(--branco);
  font: inherit;
  font-size: max(16px, .95rem);
  color: var(--texto);
}
.s-other { display: grid; gap: 10px; margin-top: 36px; list-style: none; }
.s-other a { font-family: var(--serif); font-size: 1.35rem; color: var(--verde); text-decoration: underline; text-underline-offset: 3px; }

/* carrinho (/cart) */
.cp-form { display: grid; grid-template-columns: minmax(0, 1fr) 340px; gap: clamp(28px, 4vw, 56px); align-items: start; }
.cp-list { list-style: none; border-top: 1px solid var(--linha); }
.cp-it {
  display: grid;
  grid-template-columns: 96px minmax(0, 1fr) auto auto;
  gap: 18px;
  align-items: center;
  padding: 18px 0;
  border-bottom: 1px solid var(--linha);
}
.cp-img { display: grid; place-items: center; aspect-ratio: 4 / 5; overflow: hidden; background: var(--poco); }
.cp-img img { width: 100%; height: 100%; object-fit: cover; }
.cp-info { display: grid; justify-items: start; gap: 4px; min-width: 0; }
.cp-info .p-name { font-size: 1.25rem; }
.cp-qty { display: grid; justify-items: center; gap: 4px; }
.cp-q {
  width: 72px;
  min-height: 44px;
  padding: 0 8px;
  border: 1px solid var(--trait);
  border-radius: var(--r-ui);
  background: var(--branco);
  font: inherit;
  font-size: max(16px, .95rem);
  text-align: center;
}
.cp-line { min-width: 96px; text-align: right; }
.cp-sum { position: sticky; top: calc(var(--hd-h) + 28px); padding: 24px; background: var(--papel); }
.cp-actions { display: grid; gap: 10px; }
.cp-back { text-align: center; }

/* ---------------------------------------------------------------- rodapé: políticas da loja */
.f-pol {
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  gap: 6px 22px;
  max-width: 920px;
  margin: 40px auto 0;
  font-size: .75rem;
  letter-spacing: .02em;
}
.f-pol a {
  display: inline-flex;
  align-items: center;
  min-height: 32px;
  color: var(--verde);
  text-decoration: underline;
  text-decoration-color: rgba(3, 45, 31, .35);
  text-underline-offset: 3px;
}
.f-pol a:hover { text-decoration-color: currentColor; }
.f-pol + .f-bottom { margin-top: 20px; }

/* ---------------------------------------------------------------- responsivo */
@media (max-width: 1100px) {
  /* nas páginas de coleção e busca a grade quebra em linhas (na home ela rola de lado) */
  .grid5.grid5--page {
    grid-auto-flow: row;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    grid-auto-columns: auto;
    overflow: visible;
    margin-inline: 0;
    padding: 0;
    scroll-snap-type: none;
  }
}
@media (max-width: 820px) {
  .pd-grid { grid-template-columns: 1fr; }
  .pd-info { position: static; }
  /* fotos ocupam a largura toda e passam com o dedo */
  .pd-media {
    grid-template-columns: none;
    grid-auto-flow: column;
    grid-auto-columns: 100%;
    gap: 8px;
    margin-inline: calc(var(--gutter) * -1);
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
  }
  .pd-media::-webkit-scrollbar { display: none; }
  .pd-media--multi { grid-auto-columns: calc(100% - 48px); padding-inline: var(--gutter); scroll-padding-inline: var(--gutter); }
  .pd-img { scroll-snap-align: start; }
  .grid5.grid5--page { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .cp-form { grid-template-columns: 1fr; }
  .cp-sum { position: static; }
}
@media (max-width: 560px) {
  .grid5.grid5--page { gap: 32px 12px; }
  .grid5.grid5--page .p-foot { flex-wrap: wrap; gap: 8px; }
  .s-form { flex-direction: column; }
  .cp-it { grid-template-columns: 72px minmax(0, 1fr) auto; gap: 12px 14px; align-items: start; }
  .cp-img { grid-row: span 2; }
  .cp-qty { grid-column: 2; justify-items: start; grid-auto-flow: column; align-items: center; gap: 12px; }
  .cp-line { grid-column: 3; grid-row: 1; }
}

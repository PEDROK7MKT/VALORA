{%- liquid
  # Na home os links são âncoras da própria página; nas outras páginas voltam para a home + âncora.
  if template.name == 'index'
    assign home = ''
    assign logo_href = '#top'
  else
    assign home = routes.root_url
    assign logo_href = routes.root_url
  endif

  # Título e descrição por página (na home o valora.js troca pelo idioma escolhido)
  if template.name == 'index'
    assign seo_title = "Valora Suisse — Bijoux d'exception"
    assign seo_desc = 'Bijoux qui traversent le temps. Créations en argent, or et moissanite, et pièces sur mesure — signées Valora Suisse.'
  else
    assign seo_title = page_title
    if current_tags
      assign seo_title = seo_title | append: ' · ' | append: current_tags.first
    endif
    if current_page != 1
      assign seo_title = seo_title | append: ' · ' | append: current_page
    endif
    unless seo_title contains 'Valora Suisse'
      assign seo_title = seo_title | append: ' — Valora Suisse'
    endunless
    assign seo_desc = page_description | default: 'Bijoux en argent, or et moissanite, pensés pour traverser le temps. Maison de joaillerie · Suisse.'
  endif

  assign og_image = 'hero-poster.jpg' | asset_url | prepend: 'https:'
  if template.name == 'product' and product.featured_image
    assign og_image = product.featured_image | image_url: width: 1200 | prepend: 'https:'
  elsif template.name == 'collection' and collection.featured_image
    assign og_image = collection.featured_image | image_url: width: 1200 | prepend: 'https:'
  endif
-%}
<!doctype html>
<html lang="fr">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>{{ seo_title | escape }}</title>
<meta name="description" content="{{ seo_desc | strip_newlines | escape }}">
<meta name="theme-color" content="#032D1F">
<meta name="color-scheme" content="only light">
<meta name="format-detection" content="telephone=no">
<link rel="canonical" href="{{ canonical_url }}">
<link rel="icon" href="{{ 'favicon.svg' | asset_url }}" type="image/svg+xml">
<meta property="og:type" content="{% if template.name == 'product' %}product{% else %}website{% endif %}">
<meta property="og:site_name" content="Valora Suisse">
<meta property="og:title" content="{{ seo_title | escape }}">
<meta property="og:description" content="{% if template.name == 'index' %}Bijoux en argent, or et moissanite, pensés pour traverser le temps. Maison de joaillerie · Suisse.{% else %}{{ seo_desc | strip_newlines | escape }}{% endif %}">
<meta property="og:url" content="{{ canonical_url }}">
<meta property="og:image" content="{{ og_image }}">
<meta property="og:locale" content="fr_CH">
<meta name="twitter:card" content="summary_large_image">
<link rel="preload" href="{{ 'cormorant-garamond-latin.woff2' | asset_url }}" as="font" type="font/woff2" crossorigin>
<link rel="preload" href="{{ 'montserrat-latin.woff2' | asset_url }}" as="font" type="font/woff2" crossorigin>
{%- if template.name == 'index' -%}<link rel="preload" href="{{ 'hero-ring-800.jpg' | asset_url }}" as="image" media="(max-width: 767px)">{%- endif %}
{{ 'valora-site.css' | asset_url | stylesheet_tag }}
{{ 'valora-pages.css' | asset_url | stylesheet_tag }}
{{ content_for_header }}
</head>
<body data-template="{{ template.name }}" data-locales="{%- for language in localization.available_languages -%}{{ language.iso_code }}|{{ language.root_url }}{% unless forloop.last %},{% endunless %}{%- endfor -%}">


<!doctype html>
<html lang="fr">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Valora Suisse — Bijoux d'exception</title>
<meta name="description" content="Bijoux qui traversent le temps. Créations en argent, or et moissanite, et pièces sur mesure — signées Valora Suisse.">
<meta name="theme-color" content="#032D1F">
<meta name="color-scheme" content="only light">
<meta name="format-detection" content="telephone=no">
<link rel="canonical" href="{{ canonical_url }}">
<link rel="icon" href="{{ 'favicon.svg' | asset_url }}" type="image/svg+xml">
<meta property="og:type" content="website">
<meta property="og:site_name" content="Valora Suisse">
<meta property="og:title" content="Valora Suisse — Bijoux d'exception">
<meta property="og:description" content="Bijoux en argent, or et moissanite, pensés pour traverser le temps. Maison de joaillerie · Suisse.">
<meta property="og:url" content="{{ canonical_url }}">
<meta property="og:image" content="https:{{ 'hero-poster.jpg' | asset_url }}">
<meta property="og:locale" content="fr_CH">
<meta name="twitter:card" content="summary_large_image">
<link rel="preload" href="{{ 'cormorant-garamond-latin.woff2' | asset_url }}" as="font" type="font/woff2" crossorigin>
<link rel="preload" href="{{ 'montserrat-latin.woff2' | asset_url }}" as="font" type="font/woff2" crossorigin>
{{ 'valora-site.css' | asset_url | stylesheet_tag }}
{{ content_for_header }}
</head>
<body>

<a class="skip" href="#main" data-i18n="skip">Aller au contenu</a>

<svg class="sprite" aria-hidden="true" focusable="false">
  <symbol id="i-star" viewBox="0 0 24 24"><path d="M12 0C12.9 7.6 16.4 11.1 24 12C16.4 12.9 12.9 16.4 12 24C11.1 16.4 7.6 12.9 0 12C7.6 11.1 11.1 7.6 12 0Z" fill="currentColor"/></symbol>
  <symbol id="i-star-line" viewBox="0 0 24 24"><path d="M12 1.5C12.8 7.9 16.1 11.2 22.5 12C16.1 12.8 12.8 16.1 12 22.5C11.2 16.1 7.9 12.8 1.5 12C7.9 11.2 11.2 7.9 12 1.5Z" fill="none" stroke="currentColor" stroke-width="1.1" stroke-linejoin="round"/></symbol>
  <symbol id="i-bag" viewBox="0 0 24 24"><path d="M5.5 8.5h13l-1.1 12H6.6z" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round"/><path d="M9 8.5V7a3 3 0 0 1 6 0v1.5" fill="none" stroke="currentColor" stroke-width="1.4"/></symbol>
  <symbol id="i-close" viewBox="0 0 24 24"><path d="M5 5l14 14M19 5L5 19" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></symbol>
  <symbol id="i-pause" viewBox="0 0 24 24"><path d="M7 5h3.2v14H7zM13.8 5H17v14h-3.2z" fill="currentColor"/></symbol>
  <symbol id="i-play" viewBox="0 0 24 24"><path d="M8 5l11 7-11 7z" fill="currentColor"/></symbol>
  <symbol id="i-lock" viewBox="0 0 24 24"><path d="M7.5 11V8a4.5 4.5 0 0 1 9 0v3" fill="none" stroke="currentColor" stroke-width="1.5"/><rect x="5" y="11" width="14" height="10" rx="1.5" fill="none" stroke="currentColor" stroke-width="1.5"/></symbol>
</svg>

<header class="site-header">
  <div class="hd">
    <button class="menu-btn" id="openMenu" type="button" aria-haspopup="dialog" aria-controls="menu" aria-expanded="false" aria-label="Ouvrir le menu" data-i18n-aria="menu_open"><span class="menu-ico" aria-hidden="true"></span></button>
    <a href="#top" class="brand" aria-label="Valora Suisse">
      <svg class="brand-star" aria-hidden="true" focusable="false"><use href="#i-star-line"/></svg>
      <span class="brand-name">Valora</span>
      <span class="brand-sub">Suisse</span>
    </a>
    <nav class="nav" aria-label="Navigation principale" data-i18n-aria="nav_label">
      <a href="#bagues" data-i18n="nav_bagues">Bagues</a>
      <a href="#colliers" data-i18n="nav_colliers">Colliers</a>
      <a href="#boucles" data-i18n="nav_boucles">Boucles</a>
      <a href="#bracelets" data-i18n="nav_bracelets">Bracelets</a>
      <a href="#maison" data-i18n="nav_maison">La Maison</a>
      <a href="#contact" data-i18n="nav_contact">Contact</a>
    </nav>
    <div class="hd-right">
      <div class="lang" role="group" aria-label="Langue · Idioma · Language">
        <button type="button" data-lang="fr" lang="fr" aria-pressed="true">FR<span class="sr-only"> — Français</span></button>
        <button type="button" data-lang="pt" lang="pt-BR" aria-pressed="false">PT<span class="sr-only"> — Português</span></button>
        <button type="button" data-lang="en" lang="en" aria-pressed="false">EN<span class="sr-only"> — English</span></button>
        <button type="button" data-lang="es" lang="es" aria-pressed="false">ES<span class="sr-only"> — Español</span></button>
      </div>
      <button class="cart-btn" id="openCart" type="button" aria-haspopup="dialog" aria-controls="drawer" aria-expanded="false">
        <svg class="cart-ico" aria-hidden="true" focusable="false"><use href="#i-bag"/></svg>
        <span class="cart-label" data-i18n="cart_btn">Panier</span>
        <span class="cart-count" id="cartCount">0</span><span class="sr-only" data-i18n="cart_items_sr">articles</span>
      </button>
    </div>
  </div>
</header>

<main id="main" tabindex="-1">
{{ content_for_layout }}
</main>

<div class="ribbon" aria-hidden="true"></div>

<footer>
  <div class="cards">
    <div class="bc bc-front">
      <p class="bc-logo foil">VALORA<small>SUISSE</small></p>
      <p class="bc-tag" data-i18n="f_tag">Ce qui a de la valeur demeure.</p>
    </div>
    <div class="bc bc-back">
      <p class="bc-logo sm foil" aria-hidden="true">VALORA<small>SUISSE</small></p>
      <div class="bc-line" aria-hidden="true"></div>
      <ul class="bc-info">
        <li><a href="tel:+41764407717"><svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1.9.4 1.8.7 2.6a2 2 0 0 1-.5 2.1L8.1 9.7a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.4c.8.3 1.7.5 2.6.7a2 2 0 0 1 1.7 2z"/></svg>+41 76 440 77 17</a></li>
        <li><a href="mailto:info@valorasuisse.com"><svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3 7 9 6 9-6"/></svg>info@valorasuisse.com</a></li>
        <li><a href="https://instagram.com/valorasuisse" target="_blank" rel="noopener noreferrer"><svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r=".8"/></svg>@valorasuisse<span class="sr-only" data-i18n="newtab">(nouvel onglet)</span></a></li>
        <li><span class="bc-loc"><svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M12 22s7-7.5 7-12a7 7 0 0 0-14 0c0 4.5 7 12 7 12z"/><circle cx="12" cy="10" r="2.5"/></svg><span data-i18n="f_loc">Suisse</span></span></li>
      </ul>
    </div>
  </div>
  <div class="f-bottom">
    <span data-i18n="f_rights">© 2026 Valora Suisse — Tous droits réservés</span>
    <span><span data-i18n="f_by">Conçu par</span> <a href="https://pk7.com.br" target="_blank" rel="noopener noreferrer">PK7<span class="sr-only" data-i18n="newtab">(nouvel onglet)</span></a></span>
  </div>
</footer>

<!-- Menu do celular -->
<dialog class="menu-panel" id="menu" aria-labelledby="menu-title">
  <div class="mp-h">
    <span class="brand" aria-hidden="true">
      <svg class="brand-star" focusable="false"><use href="#i-star-line"/></svg>
      <span class="brand-name">Valora</span>
      <span class="brand-sub">Suisse</span>
    </span>
    <h2 class="sr-only" id="menu-title" data-i18n="menu_title">Menu</h2>
    <button class="x" type="button" data-close aria-label="Fermer" data-i18n-aria="close"><svg aria-hidden="true" focusable="false"><use href="#i-close"/></svg></button>
  </div>
  <nav class="mp-nav" aria-label="Navigation principale" data-i18n-aria="nav_label">
    <a href="#collection" data-i18n="cat_h">La collection</a>
    <a href="#bagues" data-i18n="nav_bagues">Bagues</a>
    <a href="#colliers" data-i18n="nav_colliers">Colliers</a>
    <a href="#boucles" data-i18n="nav_boucles_full">Boucles d'oreilles</a>
    <a href="#bracelets" data-i18n="nav_bracelets">Bracelets</a>
    <a href="#maison" data-i18n="nav_maison">La Maison</a>
    <a href="#sur-mesure" data-i18n="sm_eye">Sur mesure</a>
    <a href="#contact" data-i18n="nav_contact">Contact</a>
  </nav>
  <div class="mp-foot">
    <p data-i18n="menu_lang">Langue</p>
    <div class="lang" role="group" aria-label="Langue · Idioma · Language">
      <button type="button" data-lang="fr" lang="fr" aria-pressed="true">FR<span class="sr-only"> — Français</span></button>
      <button type="button" data-lang="pt" lang="pt-BR" aria-pressed="false">PT<span class="sr-only"> — Português</span></button>
      <button type="button" data-lang="en" lang="en" aria-pressed="false">EN<span class="sr-only"> — English</span></button>
      <button type="button" data-lang="es" lang="es" aria-pressed="false">ES<span class="sr-only"> — Español</span></button>
    </div>
  </div>
</dialog>

<!-- Carrinho -->
<dialog class="drawer" id="drawer" aria-labelledby="cartTitle">
  <div class="dr-h">
    <h2 id="cartTitle" tabindex="-1" data-i18n="cart_title">Votre panier</h2>
    <button class="x" type="button" data-close aria-label="Fermer" data-i18n-aria="close"><svg aria-hidden="true" focusable="false"><use href="#i-close"/></svg></button>
  </div>
  <div class="dr-b" id="cartBody"></div>
  <div class="dr-f">
    <div class="tot"><span data-i18n="cart_sub">Sous-total</span><span class="price" id="cartTotal">CHF 0</span></div>
    <button class="btn btn-green" id="goCheckout" type="button" data-i18n="cart_go" disabled>Passer à la caisse</button>
    <p class="dr-note" data-i18n="cart_note">Livraison et taxes calculées à l'étape suivante</p>
  </div>
  <p class="sr-only" role="status" id="cartStatus"></p>
</dialog>

<script src="{{ 'valora.js' | asset_url }}" defer></script>
</body>
</html>

{%- liquid
  assign v = product.selected_or_first_available_variant

  # Coleção para "voltar" e "da mesma coleção": a da URL ou a primeira das 4 da loja
  assign coll = collection
  if coll == blank
    for c in product.collections
      if c.handle == 'aneis' or c.handle == 'colares' or c.handle == 'brincos' or c.handle == 'pulseiras'
        assign coll = c
        break
      endif
    endfor
  endif
  if coll == blank
    assign coll = product.collections.first
  endif

  # Nome provisório "Anel SH-387" (a referência já está no nome) e peça sem preço (pedido pelo WhatsApp)
  assign words = product.title | split: ' '
  assign provisional = false
  if words.size == 2 and words[1] contains 'SH-'
    assign provisional = true
  endif
  assign on_request = false
  if product.price_max == 0
    assign on_request = true
  endif

  assign media_count = 0
  for media in product.media
    if media.media_type == 'image' or media.media_type == 'video' or media.media_type == 'external_video'
      assign media_count = media_count | plus: 1
    endif
  endfor
-%}
{%- capture ck -%}{%- if coll -%}{%- render 'valora-coll-key', handle: coll.handle -%}{%- endif -%}{%- endcapture -%}
{%- assign ck = ck | strip -%}

<section class="pd" aria-labelledby="pd-title">
  <div class="sec pd-sec">
    <nav class="crumbs">
      <a class="back" href="{% if coll %}{{ coll.url }}{% else %}{{ routes.root_url }}#collection{% endif %}"><span aria-hidden="true">←</span> <span data-i18n="back_coll">Retour à la collection</span></a>
    </nav>

    <div class="pd-grid">
      <div class="pd-media{% if media_count > 1 %} pd-media--multi{% endif %}" role="group" aria-label="Photos de la pièce" data-i18n-aria="pd_photos">
        {%- for media in product.media -%}
          {%- case media.media_type -%}
            {%- when 'image' -%}
              <figure class="pd-img">
                <img src="{{ media | image_url: width: 1200 }}"
                  srcset="{{ media | image_url: width: 600 }} 600w, {{ media | image_url: width: 900 }} 900w, {{ media | image_url: width: 1200 }} 1200w, {{ media | image_url: width: 1600 }} 1600w"
                  sizes="(min-width: 821px) 56vw, 100vw"
                  width="{{ media.width }}" height="{{ media.height }}"
                  alt="{{ media.alt | default: product.title | escape }}"
                  {% if forloop.first %}fetchpriority="high"{% else %}loading="lazy"{% endif %} decoding="async">
              </figure>
            {%- when 'video' or 'external_video' -%}
              <figure class="pd-img pd-vid">{{ media | media_tag: image_size: '1200x', controls: true, muted: true, loop: true }}</figure>
          {%- endcase -%}
        {%- else -%}
          <figure class="pd-img"><svg class="p-ph" aria-hidden="true" focusable="false"><use href="#i-star"/></svg></figure>
        {%- endfor -%}
      </div>

      <div class="pd-info">
        {%- if ck != blank -%}<span class="eye" data-i18n="{{ ck }}">{{ coll.title | escape }}</span>{%- endif -%}
        <h1 class="pd-title" id="pd-title">{%- render 'valora-product-name', product: product -%}</h1>

        {%- if on_request -%}
        <div class="pd-buy">
          <p class="pd-price"><span class="p-ask" data-i18n="price_request">Prix sur demande</span></p>
          <a class="btn btn-green pd-order" href="https://wa.me/41764407717" data-wa="order" data-wa-name="{{ product.title | escape }}" data-wa-url="{{ shop.url }}{{ product.url }}" target="_blank" rel="noopener noreferrer"><span data-i18n="btn_order_wa">Commander sur WhatsApp</span><span class="sr-only" data-i18n="newtab">(nouvel onglet)</span></a>
          <p class="pd-note" data-i18n="wa_note">Prix, taille et disponibilité confirmés avec vous sur WhatsApp.</p>
        </div>
        {%- else -%}
        <div class="pd-buy">
          <p class="p-ref pd-sku"{% if v.sku == blank or provisional %} hidden{% endif %}><span data-i18n="ref">Réf.</span> <span class="pd-sku-v">{{ v.sku | escape }}</span></p>
          <p class="pd-price">
            <span class="price pd-now" data-cents="{{ v.price }}">{{ v.price | money }}</span>
            <s class="pd-was" data-cents="{{ v.compare_at_price | default: 0 }}"{% unless v.compare_at_price > v.price %} hidden{% endunless %}>{{ v.compare_at_price | money }}</s>
          </p>

          {%- unless product.has_only_default_variant -%}
            <label class="pd-label" for="pd-variant">{{ product.options | join: ' · ' | escape }}</label>
            <div class="pd-select">
              <select id="pd-variant" data-variant-select>
                {%- for variant in product.variants -%}
                  <option value="{{ variant.id }}" data-price="{{ variant.price }}" data-was="{{ variant.compare_at_price | default: 0 }}" data-available="{{ variant.available }}" data-sku="{{ variant.sku | escape }}"{% if variant.id == v.id %} selected{% endif %}>{{ variant.title | escape }}</option>
                {%- endfor -%}
              </select>
            </div>
          {%- endunless -%}

          <button class="add pd-add" type="button" data-variant="{{ v.id }}" data-name="{{ product.title | escape }}" data-sold-out="{% if v.available %}false{% else %}true{% endif %}"{% unless v.available %} disabled{% endunless %}>
            {%- if v.available -%}
              <span data-i18n="btn_add_cart">Ajouter au panier</span>
            {%- else -%}
              <span data-i18n="sold_out">Épuisé</span>
            {%- endif -%}
          </button>
          <a class="btn btn-outline pd-wa" href="https://wa.me/41764407717" data-wa="product" data-wa-name="{{ product.title | escape }}" data-wa-url="{{ shop.url }}{{ product.url }}" target="_blank" rel="noopener noreferrer"><span data-i18n="pd_question">Une question ? Écrire sur WhatsApp</span><span class="sr-only" data-i18n="newtab">(nouvel onglet)</span></a>
        </div>
        {%- endif -%}

        {%- if product.description != blank -%}
          <div class="pd-desc rte">{{ product.description }}</div>
        {%- endif -%}

        <ul class="pd-trust">
          <li><svg aria-hidden="true" focusable="false"><use href="#i-star"/></svg><span data-i18n="t1">Certificat d'authenticité</span></li>
          <li><svg aria-hidden="true" focusable="false"><use href="#i-star"/></svg><span data-i18n="t3">Livraison assurée</span></li>
          <li><svg aria-hidden="true" focusable="false"><use href="#i-star"/></svg><span data-i18n="t4">Paiement sécurisé</span></li>
        </ul>
      </div>
    </div>
  </div>
</section>

{%- if coll and coll.products_count > 1 -%}
  <section class="psec pd-more" aria-labelledby="pd-more-h">
    <div class="sec">
      <div class="psec-h">
        <h2 id="pd-more-h" data-i18n="pd_more">Dans la même collection</h2>
        {%- if ck != blank -%}<a class="psec-all" href="{{ coll.url }}" data-i18n="{{ ck }}">{{ coll.title | escape }}</a>{%- endif -%}
      </div>
      <div class="grid5">
        {%- assign shown = 0 -%}
        {%- for p in coll.products -%}
          {%- if p.id != product.id and shown < 5 -%}
            {%- render 'valora-product-card', product: p -%}
            {%- assign shown = shown | plus: 1 -%}
          {%- endif -%}
        {%- endfor -%}
      </div>
    </div>
  </section>
{%- endif -%}

{%- comment -%} Dados para o Google só com preço de verdade (com CHF 0 ele mostraria "grátis") {%- endcomment -%}
{%- unless on_request -%}
<script type="application/ld+json">{{ product | structured_data }}</script>
{%- endunless -%}

{% schema %}
{
  "name": "Valora — Produto",
  "settings": []
}
{% endschema %}

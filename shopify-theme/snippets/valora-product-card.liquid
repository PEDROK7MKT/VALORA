{%- liquid
  assign v = product.selected_or_first_available_variant
  assign img = product.featured_image
  assign pid = 'pn-' | append: product.id
-%}
<article class="prod">
  <div class="p-img">
    <a href="{{ product.url }}" tabindex="-1" aria-hidden="true">
      {%- if img -%}
        <img src="{{ img | image_url: width: 800 }}"
          srcset="{{ img | image_url: width: 480 }} 480w, {{ img | image_url: width: 800 }} 800w"
          sizes="(min-width: 1101px) 250px, (min-width: 561px) 38vw, 72vw"
          width="800" height="{{ 800 | divided_by: img.aspect_ratio | round }}"
          loading="lazy" decoding="async" alt="{{ img.alt | default: product.title | escape }}">
      {%- else -%}
        <svg class="p-ph" aria-hidden="true" focusable="false"><use href="#i-star"/></svg>
      {%- endif -%}
    </a>
  </div>
  <h3 class="p-name" id="{{ pid }}"><a href="{{ product.url }}">{{ product.title }}</a></h3>
  {%- if v.sku != blank -%}<p class="p-ref"><span data-i18n="ref">Réf.</span> {{ v.sku }}</p>{%- endif -%}
  <div class="p-foot">
    <span class="price" data-cents="{{ product.price }}">{{ product.price | money }}</span>
    <button class="add" type="button" data-variant="{{ v.id }}" data-name="{{ product.title | escape }}" aria-describedby="{{ pid }}"{% unless product.available %} disabled{% endunless %}>
      <span data-i18n="btn_add">Ajouter</span>
    </button>
  </div>
</article>

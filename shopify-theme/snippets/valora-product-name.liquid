{%- comment -%}
  Nome da peça na tela.
  Enquanto o nome na Shopify for provisório ("Anel SH-387" = categoria + referência), mostra a
  categoria no idioma escolhido + a referência ("Bague SH-387", "Ring SH-387"...).
  Quando a peça ganhar um nome de verdade, o nome aparece como está na Shopify.
  Uso: {%- render 'valora-product-name', product: product -%}
  Nos cards (card: true, g: grupo): tipo da peça em versalete (.p-cat) + referência ou nome grande (.p-sku).
{%- endcomment -%}
{%- liquid
  assign words = product.title | split: ' '
  assign cat_key = ''
  if words.size == 2 and words[1] contains 'SH-'
    case words[0]
      when 'Anel'
        assign cat_key = 'pcat_bague'
        assign cat_fr = 'Bague'
      when 'Colar'
        assign cat_key = 'pcat_collier'
        assign cat_fr = 'Collier'
      when 'Brincos'
        assign cat_key = 'pcat_boucles'
        assign cat_fr = "Boucles d'oreilles"
      when 'Pulseira'
        assign cat_key = 'pcat_bracelet'
        assign cat_fr = 'Bracelet'
    endcase
  endif

  # nome de verdade: o tipo da peça sai do grupo
  assign g_key = ''
  case g
    when 'bagues'
      assign g_key = 'pcat_bague'
      assign g_fr = 'Bague'
    when 'colliers'
      assign g_key = 'pcat_collier'
      assign g_fr = 'Collier'
    when 'boucles'
      assign g_key = 'pcat_boucles'
      assign g_fr = "Boucles d'oreilles"
    when 'bracelets'
      assign g_key = 'pcat_bracelet'
      assign g_fr = 'Bracelet'
  endcase
-%}
{%- if card -%}
  {%- if cat_key != blank -%}<span class="p-cat" data-i18n="{{ cat_key }}">{{ cat_fr }}</span> <span class="p-sku">{{ words[1] | escape }}</span>
  {%- else -%}{%- if g_key != blank -%}<span class="p-cat" data-i18n="{{ g_key }}">{{ g_fr }}</span> {% endif -%}<span class="p-sku">{{ product.title | escape }}</span>{%- endif -%}
{%- else -%}
  {%- if cat_key != blank -%}<span data-i18n="{{ cat_key }}">{{ cat_fr }}</span> {{ words[1] | escape }}{%- else -%}{{ product.title | escape }}{%- endif -%}
{%- endif -%}
